# Copy this file to backend/.env and fill in real keys.
# backend/.env is git-ignored; never commit real keys.
#
# Values are sanitized on load (surrounding quotes, trailing spaces, BOM and
# zero-width characters are removed), so KEY="sk_abc" and KEY=sk_abc both work.
# Restart the FastAPI server after changing this file.
#
# Startup logs print a masked fingerprint for each key, e.g.
#   GROQ_API_KEY: gsk_…fEeT (56 chars)
# and /api/health returns the same detail.

# --- Groq (speech-to-text + chat) ---
# Get a key at https://console.groq.com/keys (keys start with "gsk_").
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Fast, instruction-following model used by the voice/teacher agents.
# Other options on Groq: openai/gpt-oss-120b, qwen/qwen3.8-27b, allam-2-7b
# (allam-2-7b is Arabic-tuned and tends to answer in Arabic, which breaks the
# English/Urdu selection, so keep it out of the default).
GROQ_MODEL_NAME=openai/gpt-oss-20b

# --- ElevenLabs (text-to-speech) ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
# The key MUST have the "text_to_speech" permission enabled; a key without it
# returns 401 "missing the permission text_to_speech" even though it is valid.
ELEVENLABS_API_KEY=
# Voice id from your ElevenLabs account.
ELEVENLABS_VOICE_ID=21m00Tcm4FMlY31M2d8D
# eleven_multilingual_v2 is required for Urdu (Arabic script); the flash/turbo
# models are English-only. Urdu requests switch to it automatically.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# mp3_44100_128 is playable in every browser.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- CORS ---
# false = only the localhost origins plus FRONTEND_ORIGINS and
#         VERCEL_FRONTEND_ORIGIN (the production Vercel frontend).
# true  = allow every origin (credentials still work; the request Origin is
#         mirrored back instead of a literal "*"). Not recommended.
CORS_ALLOW_ALL_ORIGINS=false
# Extra browser origins, comma-separated. localhost:3000, 127.0.0.1:3000,
# localhost:3001 and 127.0.0.1:3001 are always allowed when the flag above is
# false. Use FRONTEND_ORIGINS=* to force allow-all.
FRONTEND_ORIGINS=
# The production Vercel frontend URL. Used by main.py to add the frontend to
# the CORS allow-list when CORS_ALLOW_ALL_ORIGINS is false.
VERCEL_FRONTEND_ORIGIN=https://frontend-two-flame-37.vercel.app
