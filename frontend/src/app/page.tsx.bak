  }, []);

  /**
   * Play the ElevenLabs reply and wait for it to finish (autoplay).
   */
  const playReply = useCallback(() => {
    console.log("[voice] playReply called");
  }, []);

  // ---- the whole call: listen -> reply -> speak -> listen again ----
  const startCall = useCallback(async () => {
    if (activeRef.current) return;

    setError(null);
    setWarning(null);
    setStatusBoth("listening");
    setVoiceState("listening");

    activeRef.current = true;
    setCallActive(true);
    setTranscript("");
    setReply("");

    // Unlock here, inside the tap, so every later reply can auto-play.
    await unlockAudio();

    try {
      await ensureStream();
    } catch (e) {
      console.error("[voice] Could not open the microphone", e);
      activeRef.current = false;
      setCallActive(false);
      setStatusBoth("idle");
      setVoiceState("stopped");
      setError(describeMicError(e));
      return;
    }

    const conversation: HistoryEntry[] = [];
    while (activeRef.current) {
      let blob: Blob | null = null;
      try {
        blob = await recordTurn();
      } catch (e) {
        console.error("[voice] Recording failed", e);
        setError(errorMessage(e));
        break;
      }

      if (!activeRef.current) break;
      if (!blob) continue; // silence / tap-to-cancel: keep listening

      setStatusBoth("thinking");
      setVoiceState("speaking");
      setError(null);

      try {
        // ---- transcription + reply (streamed sentence by sentence) ----
        const base64 = await blobToBase64(blob);
        const res = await fetch(`${process.env.NEXT_PUBLIC_API_URL || "http://127.0.0.1:8000"}/api/voice/stream`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            audio_base64: base64,
            audio_mime: blob.type || undefined,
            history: conversation,
            language,
            mode,
            voice_id: undefined,
          }),

        if (!res.body) {
          throw new Error("Streaming is not supported in this browser.");
        }
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";

        while (activeRef.current) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let newline = buffer.indexOf("
");
");
          while (newline >= 0) {
            const line = buffer.slice(0, newline).trim();
            buffer = buffer.slice(newline + 1);
            newline = buffer.indexOf("
");
");
            if (!line) continue;
            try {
              const event = JSON.parse(line) as {
                type: string;
                text?: string;
                audio?: string;
                error?: string;
                reply?: string;
              };
              switch (event.type) {
                case "transcript": {
                  setTranscript(event.text ?? "");
                  break;
                }
                case "sentence": {
                  console.log("[voice] Sentence received", event.text?.slice(0, 40));
                  break;
                }
                case "done": {
                  setReply(event.reply ?? "");
                  break;
                }
                case "error": {
                  throw new Error(event.error ?? "The assistant could not reply.");
                }
              }
            } catch (e) {
              console.error("[voice] Stream error", e);
              setError(errorMessage(e));
            }
          }
        }
      } catch (e) {
        console.error("[voice] Voice turn failed", e);
        setError(errorMessage(e));
      }
    }

    console.log("[voice] Call loop ended");
    releaseMedia();
    stopAudio();
    setStatusBoth("idle");
    setVoiceState("stopped");
